{
  "info": {
    "_postman_id": "c1f7b8d4-5390-482a-a92c-9a4f21d3ef89",
    "name": "Practical 9 - In-Memory Caching & Performance API",
    "description": "Postman API testing collection for CHAROTAR UNIVERSITY OF SCIENCE AND TECHNOLOGY - Practical 9: In-Memory Caching and Query Optimization (node-cache). Includes endpoints for cache validation, write invalidation, single-task caching, and cache telemetry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cache.student@charusat.edu.in\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["register"]
        },
        "description": "Registers a new user account for testing cache isolation."
      }
    },
    {
      "name": "02. Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set(\"authToken\", jsonData.token);",
              "    console.log(\"Saved authToken to environment\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cache.student@charusat.edu.in\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        },
        "description": "Authenticates user and automatically captures JWT Bearer token into environment."
      }
    },
    {
      "name": "03. Tasks - GET All Tasks (Cache Miss / Hit)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "1st call queries MongoDB (X-Cache: MISS). 2nd call serves from node-cache memory (X-Cache: HIT)."
      }
    },
    {
      "name": "04. Tasks - POST Create Task (Invalidates Cache)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData._id) {",
              "    pm.environment.set(\"taskId\", jsonData._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Implement node-cache Invalidation\",\n  \"description\": \"Verify cache invalidation upon task creation to prevent stale reads.\",\n  \"priority\": \"high\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"]
        },
        "description": "Creates a new task document and automatically invalidates the user's all-tasks cache."
      }
    },
    {
      "name": "05. Tasks - GET Single Task by ID (Cache Miss / Hit)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Tests Supplementary Requirement A: Single-task caching using key task:<userId>:<taskId>."
      }
    },
    {
      "name": "06. Tasks - PUT Update Task (Invalidates Single & All Tasks Cache)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Implement node-cache Invalidation (Updated)\",\n  \"status\": \"working\",\n  \"priority\": \"high\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Updates task and invalidates both the collection cache and single task cache."
      }
    },
    {
      "name": "07. Tasks - PATCH Partial Update Task",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Partially updates task status and invalidates relevant cache entries."
      }
    },
    {
      "name": "08. Tasks - DELETE Task (Invalidates Cache)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["tasks", "{{taskId}}"]
        },
        "description": "Deletes task and invalidates all-tasks and single-task cache."
      }
    },
    {
      "name": "09. Cache - GET Debug Statistics (/debug/cache)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/debug/cache",
          "host": ["{{baseUrl}}"],
          "path": ["debug", "cache"]
        },
        "description": "Returns telemetry metrics including hits, misses, hitRatio, active keys, and internal node-cache stats."
      }
    },
    {
      "name": "10. Cache - POST Clear Cache (/debug/cache/clear)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/debug/cache/clear",
          "host": ["{{baseUrl}}"],
          "path": ["debug", "cache", "clear"]
        },
        "description": "Flushes the node-cache in-memory store and resets hit/miss telemetry counters."
      }
    }
  ]
}
